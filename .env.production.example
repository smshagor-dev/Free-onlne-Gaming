APP_NAME="Free Games"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=free_games
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

FORCE_HTTPS=true
TRUSTED_HOSTS=^example\.com$
# Only configure proxies actually controlled by your infrastructure. Example: 10.0.0.0/8
TRUSTED_PROXIES=
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false
SANITIZE_PROVIDER_ERRORS=true
DEMO_RETENTION_HOURS=24

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT="${APP_URL}/auth/google/callback"
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT="${APP_URL}/auth/facebook/callback"
TELEGRAM_BOT_TOKEN=

RAWG_API_KEY=
RAWG_BASE_URL=https://api.rawg.io/api
RAWG_TIMEOUT=8
RAWG_CONNECT_TIMEOUT=3
FREE_TO_GAME_BASE_URL=https://www.freetogame.com/api
FREE_TO_GAME_TIMEOUT=8
FREE_TO_GAME_CONNECT_TIMEOUT=3
GAMERPOWER_BASE_URL=https://www.gamerpower.com/api
GAMERPOWER_TIMEOUT=8
GAMERPOWER_CONNECT_TIMEOUT=3
CHEAPSHARK_BASE_URL=https://www.cheapshark.com/api/1.0
CHEAPSHARK_WEB_URL=https://www.cheapshark.com
CHEAPSHARK_TIMEOUT=8
CHEAPSHARK_CONNECT_TIMEOUT=3
GAME_PROVIDER_TIMEOUT=8
GAME_PROVIDER_CONNECT_TIMEOUT=3
GAME_PROVIDER_STALE_TTL=86400
GAME_SEARCH_CACHE_TTL=3600

CASINO_API_HOST=
CASINO_CDN_URL=https://static.cdns-stat.com/resources/
CASINO_DOMAIN="${APP_URL}"
CASINO_CURRENCY=BDT
CASINO_HALL=
CASINO_KEY=
CASINO_BONUS_HALL=
CASINO_BONUS_KEY=
CASINO_CASHBACK_HALL=
CASINO_CASHBACK_KEY=
CASINO_VIP_BONUS_HALL=
CASINO_VIP_BONUS_KEY=

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=
